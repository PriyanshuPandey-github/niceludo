+    if (!pattern) return;
+
+    // NiceLudo patch: the system can stop the engine (backgrounding, audio
+    // route changes) before its stoppedHandler has run, and a stopped engine
+    // plays nothing without saying so. Start it every time - a no-op when it
+    // is running - and if playing still fails, build a fresh engine once.
+    for (int attempt = 0; attempt < 2; attempt++) {
+        [self initEngine];
