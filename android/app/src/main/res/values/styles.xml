<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- matches the launch backdrop so nothing flashes before JS draws -->
        <item name="android:windowBackground">@color/splash_backdrop</item>
    </style>

    <!--
      Shown from process start until React Native draws its first frame: the
      bare backdrop colour, which is also the first frame of the animated JS
      splash. MainActivity swaps back to AppTheme in onCreate.
    -->
    <style name="BootTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_backdrop</item>
    </style>

</resources>
