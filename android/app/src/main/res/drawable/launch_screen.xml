<?xml version="1.0" encoding="utf-8"?>
<!--
  Window background used while the process starts. It matches the first frame
  of the JS splash screen, so there is no flash between the two.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/brand_indigo_light"
                android:centerColor="@color/brand_indigo_mid"
                android:endColor="@color/brand_indigo_deep"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/splash_logo"
        android:gravity="center"
        android:width="132dp"
        android:height="132dp" />
</layer-list>
